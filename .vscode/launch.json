{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Collector: baixar e ingerir",
      "type": "debugpy",
      "request": "launch",
      "module": "collector.main",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${config:python.defaultInterpreterPath}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "COLLECTOR_LOCAL_RUN": "false",
        "COLLECTOR_LOG_LEVEL": "DEBUG"
      },
      "justMyCode": false
    },
    {
      "name": "QA: pytest + ruff + mypy",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-c",
        "import subprocess; subprocess.run(['pytest','tests','-v'], check=True); subprocess.run(['ruff','check','.'], check=True); subprocess.run(['mypy','src'], check=True)"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": false
    }
  ]
}