# Configuração do coletor (prefixo COLLECTOR_). Copie para .env e ajuste.
# NUNCA versione o .env real.

# Backend (API de ingestão) — ver docs/contratos/openapi-ingestao.yaml
COLLECTOR_BACKEND_BASE_URL=http://localhost:8080
COLLECTOR_INTERNAL_TOKEN=dev-internal-token

# Fonte Caixa (CSV) — ver docs/dados/fonte-caixa-csv.md
COLLECTOR_CSV_URL_TEMPLATE=https://venda-imoveis.caixa.gov.br/listaweb/Lista_imoveis_{uf}.csv
COLLECTOR_USER_AGENT=busca-busca-collector/0.1 (+contato: dev@technodevbr.com)

# Comportamento
COLLECTOR_REQUEST_TIMEOUT=60
COLLECTOR_BATCH_SIZE=500
COLLECTOR_VERIFY_TLS=true
COLLECTOR_FONTE=caixa
